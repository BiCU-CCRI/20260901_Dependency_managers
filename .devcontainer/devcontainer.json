{
  // Base image is the GitHub Codespaces "universal" image. It already ships
  // Python, pip, and conda/mamba, so we only need to add R for the renv part.
  // Note: pin ":2" (and the feature tags below) to a digest for a fully
  // reproducible build. We use floating tags here to keep the tutorial short.
  "name": "new-dependency-managers-tutorial",
  "image": "mcr.microsoft.com/devcontainers/universal:2",

  "features": {
    // Installs the latest R from apt and configures binary package installs
    // (via Posit Public Package Manager), so renv::restore() is fast.
    "ghcr.io/rocker-org/devcontainer-features/r-apt:latest": {},

    // Pre-installs renv itself so learners can skip the install step live.
    // "installSystemRequirements" pulls any needed system libraries.
    "ghcr.io/rocker-org/devcontainer-features/r-packages:1": {
      "packages": "renv",
      "installSystemRequirements": true
    }
  },

  // Runs once after the container is created. Kept intentionally minimal:
  // uv, pixi, pipx, and condax are installed by the learner during the
  // exercises, because installing them is part of the lesson.
  "postCreateCommand": "echo 'Container ready. Open README.md and start with exercises/01_uv.md'",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "reditorsupport.r"
      ]
    }
  }
}
